<configuration>
  <system.webServer>
    <!-- Disable default document redirect to prevent /app.js/ loops -->
    <defaultDocument enabled="false" />

    <!-- IISNode Handler -->
    <handlers>
      <add name="iisnode" path="app.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Serve Static Content Directly from /public if file exists -->
        <rule name="StaticContent" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{DOCUMENT_ROOT}/public/{R:0}" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="public/{R:0}" />
        </rule>

        <!-- Route all other dynamic requests to Node.js app.js -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="app.js" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".env" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <iisnode 
      nodeProcessCommandLine="node" 
      watchedFiles="web.config;*.js"
      loggingEnabled="true"
      debuggingEnabled="false"
    />
  </system.webServer>
</configuration>
