<!-- Working Process -->
<section class="py-5 bg-light">
  <div class="container py-4">
    <div class="section-header">
      <span class="sub-title">OUR WORKING PROCESS</span>
      <h2 class="display-6 fw-bold">How We Service Your Device</h2>
    </div>

    <div class="row g-4">
      <div class="col-md-3">
        <div class="process-step">
          <div class="process-number-badge"><i class="bi bi-telephone"></i></div>
          <h5>1. Contact Us</h5>
          <p class="small text-muted">Call or message us about your device issue.</p>
        </div>
      </div>
      <div class="col-md-3">
        <div class="process-step">
          <div class="process-number-badge"><i class="bi bi-search"></i></div>
          <h5>2. Inspection</h5>
          <p class="small text-muted">Our expert inspects & diagnoses the fault.</p>
        </div>
      </div>
      <div class="col-md-3">
        <div class="process-step">
          <div class="process-number-badge"><i class="bi bi-wrench-adjustable"></i></div>
          <h5>3. Repair</h5>
          <p class="small text-muted">We repair & thoroughly test the hardware.</p>
        </div>
      </div>
      <div class="col-md-3">
        <div class="process-step">
          <div class="process-number-badge"><i class="bi bi-box-seam"></i></div>
          <h5>4. Delivery</h5>
          <p class="small text-muted">We deliver your device safe and tested.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- FAQ Accordion -->
<section id="faq" class="py-5 bg-white">
  <div class="container py-4">
    <div class="row g-5">
      <div class="col-lg-5">
        <span class="text-info fw-bold text-uppercase small">FREQUENTLY ASKED QUESTIONS</span>
        <h2 class="display-6 fw-bold my-2">Have Questions? We Have Answers.</h2>
        <p class="text-muted">Find quick answers to common queries about our repair services, warranties, and doorstep support.</p>
        <a href="/contact" class="btn btn-outline-dark fw-semibold mt-2">
          Ask a Question <i class="bi bi-arrow-right ms-1"></i>
        </a>
      </div>

      <div class="col-lg-7">
        <div class="accordion" id="faqAccordion">
          <div class="accordion-item accordion-item-custom">
            <h2 class="accordion-header">
              <button class="accordion-button accordion-button-custom" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                Do you offer a FREE quotation service?
              </button>
            </h2>
            <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
              <div class="accordion-body text-muted small">
                Yes! We offer free quotation service and operate a No-Fix No-Fee policy. So it will cost you nothing to find out if it is worth repairing.
              </div>
            </div>
          </div>

          <div class="accordion-item accordion-item-custom">
            <h2 class="accordion-header">
              <button class="accordion-button accordion-button-custom collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                Do you repair only laptops or desktops as well?
              </button>
            </h2>
            <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
              <div class="accordion-body text-muted small">
                We repair both laptops and desktops of all major brands including Dell, HP, Lenovo, Asus, Acer, Apple MacBooks, and custom PC builds.
              </div>
            </div>
          </div>

          <div class="accordion-item accordion-item-custom">
            <h2 class="accordion-header">
              <button class="accordion-button accordion-button-custom collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                Can you replace broken laptop screens?
              </button>
            </h2>
            <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
              <div class="accordion-body text-muted small">
                Yes, we stock genuine LCD/LED screens for almost all laptop models and can replace broken screens with warranty.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

