<%- include('../layouts/header') %>

<!-- Page Title Banner -->
<section class="bg-dark text-white py-5">
  <div class="container text-center">
    <h1 class="fw-bold">Our Services</h1>
    <p class="text-info mb-0">End-to-End Hardware, Software & Network Solutions</p>
  </div>
</section>

<!-- Services Detail Grid -->
<section class="py-5 bg-light">
  <div class="container py-4">
    <div class="row g-4">

      <div class="col-md-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-4">
          <div class="fs-1 text-info mb-3"><i class="bi bi-laptop"></i></div>
          <h4 class="fw-bold">Laptop Repair & Sales</h4>
          <p class="text-muted small">Chip-level motherboard repair, screen replacement, hinge repair, battery & keyboard replacement, and sales of certified refurbished laptops.</p>
          <a href="/contact" class="btn btn-outline-dark btn-sm mt-auto">Book Service</a>
        </div>
      </div>

      <div class="col-md-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-4">
          <div class="fs-1 text-info mb-3"><i class="bi bi-pc-display"></i></div>
          <h4 class="fw-bold">Desktop Repairs & Custom PCs</h4>
          <p class="text-muted small">Power supply repairs (SMPS), motherboard replacement, RAM & NVMe SSD upgrades, virus removal, and custom gaming/workstation PC building.</p>
          <a href="/contact" class="btn btn-outline-dark btn-sm mt-auto">Book Service</a>
        </div>
      </div>

      <div class="col-md-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-4">
          <div class="fs-1 text-info mb-3"><i class="bi bi-printer"></i></div>
          <h4 class="fw-bold">Printer Repair & Servicing</h4>
          <p class="text-muted small">LaserJet & InkJet printer repair, paper jam fixes, head cleaning, toner cartridge refilling, and maintenance for HP, Canon, Epson & Brother.</p>
          <a href="/contact" class="btn btn-outline-dark btn-sm mt-auto">Book Service</a>
        </div>
      </div>

      <div class="col-md-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-4">
          <div class="fs-1 text-info mb-3"><i class="bi bi-camera-video-fill"></i></div>
          <h4 class="fw-bold">CCTV Camera Installation</h4>
          <p class="text-muted small">Full HD & IP CCTV surveillance setup with DVR/NVR configuration, night-vision cameras, and remote live smartphone access for homes & shops.</p>
          <a href="/contact" class="btn btn-outline-dark btn-sm mt-auto">Book Service</a>
        </div>
      </div>

      <div class="col-md-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-4">
          <div class="fs-1 text-info mb-3"><i class="bi bi-hdd-rack-fill"></i></div>
          <h4 class="fw-bold">Data Recovery & Backup</h4>
          <p class="text-muted small">Advanced data recovery from corrupt, formatted, damaged hard drives, SSDs, pen drives, and SD cards with strict confidential protection.</p>
          <a href="/contact" class="btn btn-outline-dark btn-sm mt-auto">Book Service</a>
        </div>
      </div>

      <div class="col-md-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-4">
          <div class="fs-1 text-info mb-3"><i class="bi bi-diagram-3-fill"></i></div>
          <h4 class="fw-bold">Networking & Wi-Fi Setup</h4>
          <p class="text-muted small">Structured LAN cabling, Wi-Fi router setup, range extender installation, firewall setup, and corporate network maintenance.</p>
          <a href="/contact" class="btn btn-outline-dark btn-sm mt-auto">Book Service</a>
        </div>
      </div>

    </div>
  </div>
</section>

<%- include('../layouts/footer') %>
