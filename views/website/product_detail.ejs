<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= product.name %> | MSD Computer Solution</title>
  
  <!-- STRICT PRIVATE CATALOG ROBOTS METATAG -->
  <meta name="robots" content="noindex, nofollow">
  
  <!-- OpenGraph Meta Tags for WhatsApp Sharing -->
  <meta property="og:title" content="<%= product.name %>">
  <meta property="og:description" content="<%= product.short_description || product.name %>">
  <% if (product.images && product.images.length > 0) { %>
    <meta property="og:image" content="<%= product.images[0].image_url %>">
  <% } %>

  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">

  <style>
    .product-detail-container {
      background-color: #fff;
      border-radius: 20px;
      box-shadow: 0 20px 40px rgba(15, 23, 42, 0.08);
      overflow: hidden;
    }
    .product-gallery-main {
      border-radius: 14px;
      overflow: hidden;
      background-color: #F8FAFC;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 380px;
    }
    .product-gallery-main img {
      max-height: 360px;
      object-fit: contain;
    }
    .thumbnail-img {
      width: 70px;
      height: 70px;
      object-fit: cover;
      border-radius: 10px;
      cursor: pointer;
      border: 2px solid transparent;
      transition: all 0.2s ease;
    }
    .thumbnail-img.active, .thumbnail-img:hover {
      border-color: var(--primary);
    }
    .spec-table th {
      width: 35%;
      color: #64748B;
      font-weight: 500;
      font-size: 0.9rem;
    }
    .spec-table td {
      color: #0F172A;
      font-weight: 600;
      font-size: 0.9rem;
    }
  </style>
</head>
<body class="bg-light">

  <!-- Minimal Brand Header (No Product Catalog Menus) -->
  <nav class="navbar navbar-dark bg-dark py-3">
    <div class="container d-flex justify-content-between align-items-center">
      <a class="navbar-brand py-0" href="/">
        <img src="/images/logo.png" alt="MSD Computer Solution" class="site-logo">
      </a>
      <a href="tel:<%= (settings && settings.phone_primary) || '+919821760849' %>" class="btn btn-outline-info btn-sm rounded-pill px-3">
        <i class="bi bi-telephone-fill me-1"></i> <%= (settings && settings.phone_primary) || '+91 9821760849' %>
      </a>
    </div>
  </nav>

  <main class="py-5">
    <div class="container">
      <div class="product-detail-container p-4 p-md-5">
        <div class="row g-5">

          <!-- Left Column: Product Image Gallery -->
          <div class="col-lg-6">
            <div class="product-gallery-main mb-3">
              <% if (product.images && product.images.length > 0) { %>
                <img id="mainProductImage" src="<%= product.images[0].image_url %>" alt="<%= product.name %>" class="img-fluid">
              <% } else { %>
                <img id="mainProductImage" src="https://images.unsplash.com/photo-1588872657578-7efd1f1555ed?w=600&auto=format&fit=crop&q=80" alt="<%= product.name %>" class="img-fluid">
              <% } %>
            </div>

            <% if (product.images && product.images.length > 1) { %>
              <div class="d-flex gap-2 overflow-auto py-2">
                <% product.images.forEach((img, idx) => { %>
                  <img src="<%= img.image_url %>" class="thumbnail-img <%= idx === 0 ? 'active' : '' %>" onclick="changeMainImage(this.src, this)">
                <% }) %>
              </div>
            <% } %>
          </div>

          <!-- Right Column: Product Information -->
          <div class="col-lg-6">
            <div class="d-flex align-items-center gap-2 mb-2">
              <span class="badge bg-info text-dark font-monospace px-3 py-2 rounded-pill"><%= product.brand || 'MSD Verified' %></span>
              <% if (product.category_name) { %>
                <span class="badge bg-secondary px-3 py-2 rounded-pill"><%= product.category_name %></span>
              <% } %>
            </div>

            <h1 class="fw-bold mb-3"><%= product.name %></h1>

            <% if (product.price && parseFloat(product.price) > 0) { %>
              <div class="mb-4">
                <span class="text-muted small">Special Price:</span>
                <div class="display-6 fw-bold text-primary">₹<%= parseFloat(product.price).toLocaleString('en-IN') %></div>
              </div>
            <% } %>

            <% if (product.short_description) { %>
              <p class="text-muted leading-relaxed mb-4"><%= product.short_description %></p>
            <% } %>

            <!-- Product Specifications Table -->
            <% 
              let specsList = [];
              try {
                let rawSpecs = typeof product.specifications === 'string' ? JSON.parse(product.specifications) : (product.specifications || []);
                if (Array.isArray(rawSpecs)) {
                  specsList = rawSpecs.map(i => {
                    if (Array.isArray(i)) return { key: i[0], value: i[1] };
                    if (typeof i === 'object' && i !== null) return { key: i.key || i.name || '', value: i.value || '' };
                    return { key: '', value: '' };
                  }).filter(i => i.key);
                } else if (typeof rawSpecs === 'object' && rawSpecs !== null) {
                  specsList = Object.entries(rawSpecs).map(([key, value]) => ({ key, value }));
                }
              } catch(e) {}
            %>
            <% if (specsList.length > 0) { %>
              <div class="mb-4">
                <h5 class="fw-bold mb-3">Technical Specifications</h5>
                <div class="table-responsive rounded-3 border">
                  <table class="table table-striped table-borderless mb-0 spec-table">
                    <tbody>
                      <% if (product.brand) { %>
                        <tr><th>Brand</th><td><%= product.brand %></td></tr>
                      <% } %>
                      <% if (product.model) { %>
                        <tr><th>Model</th><td><%= product.model %></td></tr>
                      <% } %>
                      <% specsList.forEach(item => { %>
                        <tr>
                          <th><%= item.key %></th>
                          <td><%= item.value %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>
            <% } %>

            <% if (product.full_description) { %>
              <div class="mb-4">
                <h5 class="fw-bold mb-2">Full Description</h5>
                <p class="text-muted small leading-relaxed"><%= product.full_description %></p>
              </div>
            <% } %>

            <!-- Direct WhatsApp & Phone Call Action Buttons -->
            <div class="d-grid gap-3 mt-4">
              <% 
                const waText = encodeURIComponent(`Hello MSD Computer Solution, I am interested in: ${product.name} (Price: ₹${product.price}). Here is the link: ${currentUrl}`);
                const waNumber = (settings && settings.whatsapp_number) || '919821760849';
              %>
              <a href="https://wa.me/<%= waNumber %>?text=<%= waText %>" target="_blank" class="btn btn-success btn-lg py-3 fw-bold rounded-3">
                <i class="bi bi-whatsapp me-2"></i> INQUIRE VIA WHATSAPP NOW
              </a>
              <a href="tel:<%= (settings && settings.phone_primary) || '+919821760849' %>" class="btn btn-dark btn-lg py-3 fw-bold rounded-3">
                <i class="bi bi-telephone-fill me-2"></i> CALL US TO ORDER / INQUIRE
              </a>
            </div>

          </div>

        </div>
      </div>
    </div>
  </main>

  <script>
    function changeMainImage(src, element) {
      document.getElementById('mainProductImage').src = src;
      document.querySelectorAll('.thumbnail-img').forEach(img => img.classList.remove('active'));
      element.classList.add('active');
    }
  </script>

</body>
</html>
