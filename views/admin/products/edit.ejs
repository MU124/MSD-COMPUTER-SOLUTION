<%- include('../../layouts/admin_header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-1">Edit Product</h2>
    <p class="text-muted small mb-0">Update item details, crop & compress images, and manage access links.</p>
  </div>
  <a href="/admin/products" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left me-1"></i> Back to Products
  </a>
</div>

<!-- Private Link & Token Regeneration Box -->
<% const currentShareUrl = `${baseUrl}/product/${product.seo_slug}-${product.public_token}`; %>
<div class="card border-0 shadow-sm rounded-4 p-4 bg-dark text-white mb-4">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
      <div class="text-info fw-bold small text-uppercase mb-1"><i class="bi bi-shield-lock-fill me-1"></i> Active Tokenized Access Link</div>
      <div class="font-monospace text-light small word-break-all"><%= currentShareUrl %></div>
    </div>

    <div class="d-flex gap-2">
      <button type="button" class="btn btn-info btn-sm fw-semibold" onclick="navigator.clipboard.writeText('<%= currentShareUrl %>'); alert('Private URL copied to clipboard!');">
        <i class="bi bi-clipboard me-1"></i> Copy Link
      </button>

      <form action="/admin/products/regenerate-token/<%= product.id %>" method="POST" onsubmit="return confirm('WARNING: Regenerating the token will immediately invalidate all previously shared links for this product! Continue?');">
        <button type="submit" class="btn btn-outline-warning btn-sm fw-semibold">
          <i class="bi bi-arrow-clockwise me-1"></i> Regenerate Token
        </button>
      </form>
    </div>
  </div>
</div>

<form id="productForm" action="/admin/products/edit/<%= product.id %>" method="POST" enctype="multipart/form-data">
  <div class="row g-4">

    <!-- Left Column -->
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <h5 class="fw-bold mb-3">General Information</h5>

        <div class="mb-3">
          <label class="form-label small fw-semibold">Product Name *</label>
          <input type="text" name="name" class="form-control" value="<%= product.name %>" required>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label small fw-semibold">Brand</label>
            <input type="text" name="brand" class="form-control" value="<%= product.brand || '' %>">
          </div>
          <div class="col-md-6">
            <label class="form-label small fw-semibold">Model</label>
            <input type="text" name="model" class="form-control" value="<%= product.model || '' %>">
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label small fw-semibold">Short Description</label>
          <textarea name="short_description" class="form-control" rows="2"><%= product.short_description || '' %></textarea>
        </div>

        <div class="mb-3">
          <label class="form-label small fw-semibold">Full Description</label>
          <textarea name="full_description" class="form-control" rows="5"><%= product.full_description || '' %></textarea>
        </div>
      </div>

      <!-- Specification Matrix Builder -->
      <% 
        let specsObj = {};
        try {
          specsObj = typeof product.specifications === 'string' ? JSON.parse(product.specifications) : (product.specifications || {});
        } catch(e) {}
      %>
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="fw-bold mb-0">Technical Specifications</h5>
          <button type="button" class="btn btn-sm btn-outline-primary" onclick="addSpecRow()">
            <i class="bi bi-plus-lg me-1"></i> Add Spec Row
          </button>
        </div>

        <div id="specsContainer">
          <% const keys = Object.keys(specsObj); %>
          <% if (keys.length > 0) { %>
            <% keys.forEach(key => { %>
              <div class="row g-2 mb-2 spec-row">
                <div class="col-5">
                  <input type="text" name="specs_keys" class="form-control form-control-sm" value="<%= key %>">
                </div>
                <div class="col-6">
                  <input type="text" name="specs_values" class="form-control form-control-sm" value="<%= specsObj[key] %>">
                </div>
                <div class="col-1 text-end">
                  <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeSpecRow(this)"><i class="bi bi-x"></i></button>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="row g-2 mb-2 spec-row">
              <div class="col-5">
                <input type="text" name="specs_keys" class="form-control form-control-sm" placeholder="Spec Name">
              </div>
              <div class="col-6">
                <input type="text" name="specs_values" class="form-control form-control-sm" placeholder="Value">
              </div>
              <div class="col-1 text-end">
                <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeSpecRow(this)"><i class="bi bi-x"></i></button>
              </div>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Uploaded Images & Cropper -->
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <h5 class="fw-bold mb-3">Existing Uploaded Images</h5>
        
        <% if (product.images && product.images.length > 0) { %>
          <div class="row g-3 mb-4">
            <% product.images.forEach(img => { %>
              <div class="col-6 col-sm-4 col-md-3">
                <div class="card border shadow-sm h-100 text-center p-2">
                  <img src="<%= img.image_url %>" class="img-fluid rounded mb-2 style-img-thumb" style="height: 110px; object-fit: contain;">
                  <% if (img.is_primary) { %>
                    <span class="badge bg-primary mb-2">Primary Photo</span>
                  <% } %>
                  <button type="button" class="btn btn-sm btn-outline-danger w-100 mt-auto" onclick="deleteExistingImage('<%= img.id %>', '<%= product.id %>')">
                    <i class="bi bi-trash-fill me-1"></i> Delete
                  </button>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="text-muted small">No images uploaded yet.</p>
        <% } %>

        <hr>

        <h6 class="fw-bold mb-2">Add & Crop New Images</h6>
        <p class="text-muted small mb-3">Select images to open the interactive cropper & auto-compress size before upload.</p>
        
        <input type="file" id="imageInput" name="images" class="form-control mb-3" accept="image/*" multiple>

        <!-- Container for Live Cropped Previews -->
        <div id="croppedPreviewsContainer" class="d-flex gap-3 flex-wrap"></div>
      </div>
    </div>

    <!-- Right Column -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <h5 class="fw-bold mb-3">Internal Financial Matrix</h5>

        <div class="mb-3">
          <label class="form-label small fw-semibold">Vendor Cost (₹)</label>
          <input type="number" step="0.01" id="vendor_cost" name="vendor_cost" class="form-control" value="<%= product.vendor_cost || 0 %>" oninput="calculatePrice()">
        </div>

        <div class="mb-3">
          <label class="form-label small fw-semibold">Profit Margin (₹)</label>
          <input type="number" step="0.01" id="profit_margin" name="profit_margin" class="form-control" value="<%= product.profit_margin || 0 %>" oninput="calculatePrice()">
        </div>

        <div class="mb-3">
          <label class="form-label small fw-semibold text-primary">Final Selling Price (₹) *</label>
          <input type="number" step="0.01" id="price" name="price" class="form-control fw-bold border-primary" value="<%= product.price || 0 %>" required>
        </div>

        <div class="mb-3">
          <label class="form-label small fw-semibold">Stock Quantity</label>
          <input type="number" name="stock_quantity" class="form-control" value="<%= product.stock_quantity || 1 %>">
        </div>
      </div>

      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <h5 class="fw-bold mb-3">Category & Status</h5>

        <div class="mb-3">
          <label class="form-label small fw-semibold">Category</label>
          <select name="category_id" class="form-select">
            <option value="">-- Select Category --</option>
            <% if (categories) { %>
              <% categories.forEach(c => { %>
                <option value="<%= c.id %>" <%= product.category_id == c.id ? 'selected' : '' %>><%= c.name %></option>
              <% }) %>
            <% } %>
          </select>
        </div>

        <div class="mb-3">
          <label class="form-label small fw-semibold">Status</label>
          <select name="status" class="form-select">
            <option value="active" <%= product.status === 'active' ? 'selected' : '' %>>Active</option>
            <option value="inactive" <%= product.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
          </select>
        </div>

        <div class="form-check mb-3">
          <input class="form-check-input" type="checkbox" name="featured" id="featured" value="1" <%= product.featured ? 'checked' : '' %>>
          <label class="form-check-label small fw-semibold" for="featured">
            Mark as Featured Item
          </label>
        </div>
      </div>

      <button type="submit" class="btn btn-primary-custom w-100 py-3">
        <i class="bi bi-save-fill me-1"></i> UPDATE PRODUCT
      </button>
    </div>

  </div>
</form>

<!-- Existing Image Deletion Form -->
<form id="deleteImageForm" method="POST" style="display:none;"></form>

<!-- Cropper Modal -->
<div class="modal fade" id="cropperModal" tabindex="-1" data-bs-backdrop="static">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold">Crop & Compress Image</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body text-center p-3">
        <div style="max-height: 450px; overflow: hidden;" class="bg-dark rounded">
          <img id="cropperImage" style="max-width: 100%; display: block;">
        </div>
      </div>
      <div class="modal-footer justify-content-between">
        <div class="small text-muted">Crop area will be compressed to ~80KB-120KB WebP/JPEG format.</div>
        <div>
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary-custom" id="cropAndSaveBtn">
            <i class="bi bi-crop me-1"></i> Crop & Compress
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function deleteExistingImage(imageId, productId) {
    if (confirm('Are you sure you want to delete this image permanently?')) {
      const form = document.getElementById('deleteImageForm');
      form.action = `/admin/products/delete-image/${imageId}/${productId}`;
      form.submit();
    }
  }

  function calculatePrice() {
    const cost = parseFloat(document.getElementById('vendor_cost').value) || 0;
    const margin = parseFloat(document.getElementById('profit_margin').value) || 0;
    if (cost > 0 || margin > 0) {
      document.getElementById('price').value = (cost + margin).toFixed(2);
    }
  }

  function addSpecRow() {
    const div = document.createElement('div');
    div.className = 'row g-2 mb-2 spec-row';
    div.innerHTML = `
      <div class="col-5">
        <input type="text" name="specs_keys" class="form-control form-control-sm" placeholder="Spec Name">
      </div>
      <div class="col-6">
        <input type="text" name="specs_values" class="form-control form-control-sm" placeholder="Value">
      </div>
      <div class="col-1 text-end">
        <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeSpecRow(this)"><i class="bi bi-x"></i></button>
      </div>
    `;
    document.getElementById('specsContainer').appendChild(div);
  }

  function removeSpecRow(btn) {
    btn.closest('.spec-row').remove();
  }

  // --- CROPPER & COMPRESSION LOGIC ---
  document.addEventListener('DOMContentLoaded', function () {
    let cropper = null;
    let fileQueue = [];
    let currentFileIndex = 0;
    let isSaved = false;
    const croppedFiles = []; // Array of Blobs

    const imageInput = document.getElementById('imageInput');
    const cropperModalEl = document.getElementById('cropperModal');
    const cropperModal = new bootstrap.Modal(cropperModalEl);
    const cropperImage = document.getElementById('cropperImage');
    const cropAndSaveBtn = document.getElementById('cropAndSaveBtn');
    const previewsContainer = document.getElementById('croppedPreviewsContainer');
    const productForm = document.getElementById('productForm');

    imageInput.addEventListener('change', function (e) {
      if (e.target.files && e.target.files.length > 0) {
        fileQueue = Array.from(e.target.files);
        currentFileIndex = 0;
        processNextFile();
      }
    });

    function processNextFile() {
      if (currentFileIndex < fileQueue.length) {
        isSaved = false;
        const file = fileQueue[currentFileIndex];
        const reader = new FileReader();
        reader.onload = function (evt) {
          cropperImage.src = evt.target.result;
          cropperModal.show();
        };
        reader.readAsDataURL(file);
      } else {
        imageInput.value = '';
      }
    }

    cropperModalEl.addEventListener('shown.bs.modal', function () {
      if (cropper) cropper.destroy();
      cropper = new Cropper(cropperImage, {
        aspectRatio: 1, // 1:1 Square Ratio
        viewMode: 1,
        autoCropArea: 0.9,
        responsive: true
      });
    });

    cropperModalEl.addEventListener('hidden.bs.modal', function () {
      if (cropper) {
        cropper.destroy();
        cropper = null;
      }
      if (!isSaved) {
        currentFileIndex++;
        if (currentFileIndex < fileQueue.length) {
          setTimeout(processNextFile, 200);
        } else {
          imageInput.value = '';
        }
      }
    });

    cropAndSaveBtn.addEventListener('click', function () {
      if (!cropper) return;
      isSaved = true;
      
      // Canvas at 800x800 resolution with 80% compression
      const canvas = cropper.getCroppedCanvas({
        width: 800,
        height: 800
      });

      if (!canvas) {
        cropperModal.hide();
        return;
      }

      canvas.toBlob(function (blob) {
        if (!blob) {
          cropperModal.hide();
          return;
        }

        const fileName = `cropped-${Date.now()}-${currentFileIndex}.jpg`;
        const croppedFile = new File([blob], fileName, { type: 'image/jpeg' });
        croppedFiles.push(croppedFile);

        // Create preview card with file size
        const sizeKB = (blob.size / 1024).toFixed(1);
        const previewDiv = document.createElement('div');
        previewDiv.className = 'border rounded p-2 text-center bg-light position-relative';
        previewDiv.style.width = '120px';
        
        const img = document.createElement('img');
        img.src = URL.createObjectURL(blob);
        img.className = 'img-fluid rounded mb-1';
        img.style.height = '80px';
        img.style.objectFit = 'cover';

        const badge = document.createElement('div');
        badge.className = 'badge bg-success small mb-1';
        badge.innerText = `${sizeKB} KB`;

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'btn btn-sm btn-outline-danger w-100 py-0';
        removeBtn.innerHTML = '<i class="bi bi-x-circle"></i> Remove';
        removeBtn.onclick = function () {
          const idx = croppedFiles.indexOf(croppedFile);
          if (idx > -1) croppedFiles.splice(idx, 1);
          previewDiv.remove();
        };

        previewDiv.appendChild(img);
        previewDiv.appendChild(badge);
        previewDiv.appendChild(removeBtn);
        previewsContainer.appendChild(previewDiv);

        cropperModal.hide();
        currentFileIndex++;
        if (currentFileIndex < fileQueue.length) {
          setTimeout(processNextFile, 300);
        } else {
          imageInput.value = ''; // Reset original input
        }
      }, 'image/jpeg', 0.82); // 82% quality compression
    });

    // Attach cropped files to Form Data on submit
    productForm.addEventListener('submit', function (e) {
      if (croppedFiles.length > 0) {
        const dataTransfer = new DataTransfer();
        croppedFiles.forEach(f => dataTransfer.items.add(f));
        imageInput.files = dataTransfer.files;
      }
    });
  });
</script>

<%- include('../../layouts/admin_footer') %>
