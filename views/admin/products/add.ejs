<%- include('../../layouts/admin_header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-1">Add New Product</h2>
    <p class="text-muted small mb-0">Create a new private item with interactive cropping & auto-compression.</p>
  </div>
  <a href="/admin/products" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left me-1"></i> Back to Products
  </a>
</div>

<form id="productForm" action="/admin/products/add" method="POST" enctype="multipart/form-data">
  <div class="row g-4">
    
    <!-- Left Column: Details -->
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <h5 class="fw-bold mb-3">General Information</h5>

        <div class="mb-3">
          <label class="form-label small fw-semibold">Product Name *</label>
          <input type="text" name="name" class="form-control" placeholder="e.g. Dell Latitude 5440 Core i5 13th Gen" required>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label small fw-semibold">Brand</label>
            <input type="text" name="brand" class="form-control" placeholder="e.g. Dell, HP, Lenovo">
          </div>
          <div class="col-md-6">
            <label class="form-label small fw-semibold">Model</label>
            <input type="text" name="model" class="form-control" placeholder="e.g. Latitude 5440">
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label small fw-semibold">Short Description</label>
          <textarea name="short_description" class="form-control" rows="2" placeholder="Brief summary of product features..."></textarea>
        </div>

        <div class="mb-3">
          <label class="form-label small fw-semibold">Full Description</label>
          <textarea name="full_description" class="form-control" rows="5" placeholder="Detailed product overview, warranty info, condition, etc..."></textarea>
        </div>
      </div>

      <!-- Specification Matrix Builder -->
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="fw-bold mb-0">Technical Specifications</h5>
          <button type="button" class="btn btn-sm btn-outline-primary" onclick="addSpecRow()">
            <i class="bi bi-plus-lg me-1"></i> Add Spec Row
          </button>
        </div>
        <p class="text-muted small mb-3">Add custom specification fields (RAM, Processor, Storage, Graphics, Display, etc.)</p>

        <div id="specsContainer">
          <div class="row g-2 mb-2 spec-row">
            <div class="col-5">
              <input type="text" name="specs_keys" class="form-control form-control-sm" placeholder="Spec Name (e.g. RAM)">
            </div>
            <div class="col-6">
              <input type="text" name="specs_values" class="form-control form-control-sm" placeholder="Value (e.g. 16GB DDR5)">
            </div>
            <div class="col-1 text-end">
              <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeSpecRow(this)"><i class="bi bi-x"></i></button>
            </div>
          </div>
        </div>
      </div>

      <!-- Image Uploads & Cropper -->
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <h5 class="fw-bold mb-2">Product Images & Cropper</h5>
        <p class="text-muted small mb-3">Select images to crop & auto-compress size (~80KB-120KB) before uploading.</p>
        
        <input type="file" id="imageInput" name="images" class="form-control mb-3" accept="image/*" multiple>

        <!-- Container for Live Cropped Previews -->
        <div id="croppedPreviewsContainer" class="d-flex gap-3 flex-wrap"></div>
      </div>
    </div>

    <!-- Right Column: Financial & Pricing Matrix -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <h5 class="fw-bold mb-3">Internal Financial Matrix</h5>
        <p class="text-muted small mb-3">Calculate selling price based on cost & margin. Hidden from public buyers!</p>

        <div class="mb-3">
          <label class="form-label small fw-semibold">Vendor Cost (₹)</label>
          <input type="number" step="0.01" id="vendor_cost" name="vendor_cost" class="form-control" placeholder="0.00" oninput="calculatePrice()">
        </div>

        <div class="mb-3">
          <label class="form-label small fw-semibold">Profit Margin (₹)</label>
          <input type="number" step="0.01" id="profit_margin" name="profit_margin" class="form-control" placeholder="0.00" oninput="calculatePrice()">
        </div>

        <div class="mb-3">
          <label class="form-label small fw-semibold text-primary">Final Selling Price (₹) *</label>
          <input type="number" step="0.01" id="price" name="price" class="form-control fw-bold border-primary" placeholder="0.00" required>
        </div>

        <div class="mb-3">
          <label class="form-label small fw-semibold">Stock Quantity</label>
          <input type="number" name="stock_quantity" class="form-control" value="1">
        </div>
      </div>

      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <h5 class="fw-bold mb-3">Category & Visibility</h5>

        <div class="mb-3">
          <label class="form-label small fw-semibold">Category</label>
          <select name="category_id" class="form-select">
            <option value="">-- Select Category --</option>
            <% if (categories) { %>
              <% categories.forEach(c => { %>
                <option value="<%= c.id %>"><%= c.name %></option>
              <% }) %>
            <% } %>
          </select>
        </div>

        <div class="mb-3">
          <label class="form-label small fw-semibold">Status</label>
          <select name="status" class="form-select">
            <option value="active" selected>Active (Accessible via Token)</option>
            <option value="inactive">Inactive (Disabled)</option>
          </select>
        </div>

        <div class="form-check mb-3">
          <input class="form-check-input" type="checkbox" name="featured" id="featured" value="1">
          <label class="form-check-label small fw-semibold" for="featured">
            Mark as Featured Item
          </label>
        </div>
      </div>

      <button type="submit" class="btn btn-primary-custom w-100 py-3">
        <i class="bi bi-check-circle-fill me-1"></i> SAVE & GENERATE LINK
      </button>
    </div>

  </div>
</form>

<!-- Cropper Modal -->
<div class="modal fade" id="cropperModal" tabindex="-1" data-bs-backdrop="static">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold">Crop & Compress Image</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body text-center p-3">
        <div style="max-height: 450px; overflow: hidden;" class="bg-dark rounded">
          <img id="cropperImage" style="max-width: 100%; display: block;">
        </div>
      </div>
      <div class="modal-footer justify-content-between">
        <div class="small text-muted">Crop area will be compressed to ~80KB-120KB WebP/JPEG format.</div>
        <div>
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary-custom" id="cropAndSaveBtn">
            <i class="bi bi-crop me-1"></i> Crop & Compress
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculatePrice() {
    const cost = parseFloat(document.getElementById('vendor_cost').value) || 0;
    const margin = parseFloat(document.getElementById('profit_margin').value) || 0;
    if (cost > 0 || margin > 0) {
      document.getElementById('price').value = (cost + margin).toFixed(2);
    }
  }

  function addSpecRow() {
    const div = document.createElement('div');
    div.className = 'row g-2 mb-2 spec-row';
    div.innerHTML = `
      <div class="col-5">
        <input type="text" name="specs_keys" class="form-control form-control-sm" placeholder="Spec Name">
      </div>
      <div class="col-6">
        <input type="text" name="specs_values" class="form-control form-control-sm" placeholder="Value">
      </div>
      <div class="col-1 text-end">
        <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeSpecRow(this)"><i class="bi bi-x"></i></button>
      </div>
    `;
    document.getElementById('specsContainer').appendChild(div);
  }

  function removeSpecRow(btn) {
    btn.closest('.spec-row').remove();
  }

  // --- CROPPER & COMPRESSION LOGIC ---
  document.addEventListener('DOMContentLoaded', function () {
    let cropper = null;
    let fileQueue = [];
    let currentFileIndex = 0;
    let isSaved = false;
    const croppedFiles = [];

    const imageInput = document.getElementById('imageInput');
    const cropperModalEl = document.getElementById('cropperModal');
    const cropperModal = new bootstrap.Modal(cropperModalEl);
    const cropperImage = document.getElementById('cropperImage');
    const cropAndSaveBtn = document.getElementById('cropAndSaveBtn');
    const previewsContainer = document.getElementById('croppedPreviewsContainer');
    const productForm = document.getElementById('productForm');

    imageInput.addEventListener('change', function (e) {
      if (e.target.files && e.target.files.length > 0) {
        fileQueue = Array.from(e.target.files);
        currentFileIndex = 0;
        processNextFile();
      }
    });

    function processNextFile() {
      if (currentFileIndex < fileQueue.length) {
        isSaved = false;
        const file = fileQueue[currentFileIndex];
        const reader = new FileReader();
        reader.onload = function (evt) {
          cropperImage.src = evt.target.result;
          cropperModal.show();
        };
        reader.readAsDataURL(file);
      } else {
        imageInput.value = '';
      }
    }

    cropperModalEl.addEventListener('shown.bs.modal', function () {
      if (cropper) cropper.destroy();
      cropper = new Cropper(cropperImage, {
        aspectRatio: 1, // 1:1 Square Ratio
        viewMode: 1,
        autoCropArea: 0.9,
        responsive: true
      });
    });

    cropperModalEl.addEventListener('hidden.bs.modal', function () {
      if (cropper) {
        cropper.destroy();
        cropper = null;
      }
      if (!isSaved) {
        currentFileIndex++;
        if (currentFileIndex < fileQueue.length) {
          setTimeout(processNextFile, 200);
        } else {
          imageInput.value = '';
        }
      }
    });

    cropAndSaveBtn.addEventListener('click', function () {
      if (!cropper) return;
      isSaved = true;
      
      // Canvas at 800x800 resolution with 80% compression
      const canvas = cropper.getCroppedCanvas({
        width: 800,
        height: 800
      });

      if (!canvas) {
        cropperModal.hide();
        return;
      }

      canvas.toBlob(function (blob) {
        if (!blob) {
          cropperModal.hide();
          return;
        }

        const fileName = `cropped-${Date.now()}-${currentFileIndex}.jpg`;
        const croppedFile = new File([blob], fileName, { type: 'image/jpeg' });
        croppedFiles.push(croppedFile);

        // Create preview card with file size
        const sizeKB = (blob.size / 1024).toFixed(1);
        const previewDiv = document.createElement('div');
        previewDiv.className = 'border rounded p-2 text-center bg-light position-relative';
        previewDiv.style.width = '120px';
        
        const img = document.createElement('img');
        img.src = URL.createObjectURL(blob);
        img.className = 'img-fluid rounded mb-1';
        img.style.height = '80px';
        img.style.objectFit = 'cover';

        const badge = document.createElement('div');
        badge.className = 'badge bg-success small mb-1';
        badge.innerText = `${sizeKB} KB`;

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'btn btn-sm btn-outline-danger w-100 py-0';
        removeBtn.innerHTML = '<i class="bi bi-x-circle"></i> Remove';
        removeBtn.onclick = function () {
          const idx = croppedFiles.indexOf(croppedFile);
          if (idx > -1) croppedFiles.splice(idx, 1);
          previewDiv.remove();
        };

        previewDiv.appendChild(img);
        previewDiv.appendChild(badge);
        previewDiv.appendChild(removeBtn);
        previewsContainer.appendChild(previewDiv);

        cropperModal.hide();
        currentFileIndex++;
        if (currentFileIndex < fileQueue.length) {
          setTimeout(processNextFile, 300);
        } else {
          imageInput.value = '';
        }
      }, 'image/jpeg', 0.82);
    });

    productForm.addEventListener('submit', function (e) {
      if (croppedFiles.length > 0) {
        const dataTransfer = new DataTransfer();
        croppedFiles.forEach(f => dataTransfer.items.add(f));
        imageInput.files = dataTransfer.files;
      }
    });
  });
</script>

<%- include('../../layouts/admin_footer') %>
