<%- include('../../layouts/admin_header') %>

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
  <div>
    <h2 class="fw-bold mb-1 fs-3">Product Management</h2>
    <p class="text-muted small mb-0">Private product catalog with secure NanoID token links.</p>
  </div>
  <a href="/admin/products/add" class="btn btn-primary-custom text-nowrap align-self-start align-self-sm-center">
    <i class="bi bi-plus-lg me-1"></i> Add Product
  </a>
</div>

<!-- Search & Filter Toolbar -->
<div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
  <form action="/admin/products" method="GET" class="row g-2 align-items-center">
    <div class="col-12 col-md-4">
      <div class="input-group input-group-sm">
        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
        <input type="text" name="search" class="form-control" placeholder="Search by Name, Brand, or Model..." value="<%= filters.search %>">
      </div>
    </div>

    <div class="col-12 col-md-3">
      <select name="category" class="form-select form-select-sm">
        <option value="">-- All Categories --</option>
        <% if (categories) { %>
          <% categories.forEach(c => { %>
            <option value="<%= c.id %>" <%= filters.category == c.id ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        <% } %>
      </select>
    </div>

    <div class="col-12 col-md-2">
      <select name="status" class="form-select form-select-sm">
        <option value="">-- All Status --</option>
        <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
        <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
      </select>
    </div>

    <div class="col-12 col-md-3 d-flex align-items-center gap-2">
      <button type="submit" class="btn btn-sm btn-primary-custom flex-grow-1 d-inline-flex align-items-center justify-content-center gap-1 py-1 px-3">
        <i class="bi bi-funnel-fill"></i> Filter
      </button>
      <a href="/admin/products" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center justify-content-center gap-1 py-1 px-3" title="Reset Filters">
        <i class="bi bi-arrow-counterclockwise"></i> Reset
      </a>
    </div>
  </form>
</div>

<!-- Product List Card -->
<div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 bg-white">
  <% if (products && products.length > 0) { %>
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div class="small text-muted">
        Showing <%= ((pagination.currentPage - 1) * pagination.limit) + 1 %> - <%= Math.min(pagination.currentPage * pagination.limit, pagination.totalCount) %> of <%= pagination.totalCount %> products
      </div>
    </div>

    <!-- Desktop Table View (>= 768px) -->
    <div class="table-responsive d-none d-md-block">
      <table class="table table-hover align-middle mb-0 text-nowrap">
        <thead class="table-light">
          <tr>
            <th>Product Details</th>
            <th>Selling Price</th>
            <th>Vendor Cost</th>
            <th>Profit Margin</th>
            <th>Status</th>
            <th>Private Share Link</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(p => { %>
            <% 
              const productUrl = `${baseUrl}/product/${p.seo_slug}-${p.public_token}`;
              const waText = encodeURIComponent(`Check out: ${p.name} - Price: ₹${p.price}\nLink: ${productUrl}`);
            %>
            <tr>
              <td>
                <div class="fw-bold text-dark"><%= p.name %></div>
                <div class="small text-muted"><%= p.brand ? p.brand : '' %> <%= p.model ? '(' + p.model + ')' : '' %> | <%= p.category_name || 'Uncategorized' %></div>
              </td>
              <td class="fw-bold text-primary">₹<%= parseFloat(p.price || 0).toLocaleString('en-IN') %></td>
              <td class="text-muted small">
                <div>₹<%= parseFloat(p.vendor_cost || 0).toLocaleString('en-IN') %></div>
                <% if (p.vendor_name) { %>
                  <div class="text-muted text-truncate extra-small" style="max-width: 130px; font-size: 0.75rem;" title="<%= p.vendor_name %>">
                    <i class="bi bi-shop me-1"></i><%= p.vendor_name %>
                  </div>
                <% } %>
              </td>
              <td class="text-success fw-bold small">₹<%= parseFloat(p.profit_margin || 0).toLocaleString('en-IN') %></td>
              <td>
                <% if (p.status === 'active') { %>
                  <span class="badge bg-success bg-opacity-10 text-success px-2 py-1">Active</span>
                <% } else { %>
                  <span class="badge bg-secondary bg-opacity-10 text-secondary px-2 py-1">Inactive</span>
                <% } %>
              </td>
              <td>
                <div class="input-group input-group-sm" style="min-width: 250px; max-width: 300px;">
                  <input type="text" class="form-control text-truncate" value="<%= productUrl %>" readonly id="link-desktop-<%= p.id %>">
                  <button class="btn btn-outline-secondary" onclick="copyLink('link-desktop-<%= p.id %>', this)" title="Copy Link">
                    <i class="bi bi-clipboard"></i>
                  </button>
                  <a href="https://wa.me/?text=<%= waText %>" target="_blank" class="btn btn-outline-success" title="Share on WhatsApp">
                    <i class="bi bi-whatsapp"></i>
                  </a>
                </div>
              </td>
              <td class="text-end">
                <div class="d-inline-flex gap-2">
                  <a href="/admin/products/edit/<%= p.id %>" class="btn btn-sm btn-outline-dark rounded-2" title="Edit">
                    <i class="bi bi-pencil-fill"></i>
                  </a>
                  <form action="/admin/products/delete/<%= p.id %>" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this product?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-2" title="Delete">
                      <i class="bi bi-trash-fill"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Mobile Card View (< 768px) -->
    <div class="d-flex flex-column gap-3 d-md-none">
      <% products.forEach(p => { %>
        <% 
          const productUrl = `${baseUrl}/product/${p.seo_slug}-${p.public_token}`;
          const waText = encodeURIComponent(`Check out: ${p.name} - Price: ₹${p.price}\nLink: ${productUrl}`);
        %>
        <div class="border rounded-3 p-3 bg-light bg-opacity-50">
          <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
            <div>
              <div class="fw-bold text-dark fs-6"><%= p.name %></div>
              <div class="small text-muted"><%= p.brand ? p.brand : '' %> <%= p.model ? '(' + p.model + ')' : '' %> | <%= p.category_name || 'Uncategorized' %></div>
            </div>
            <% if (p.status === 'active') { %>
              <span class="badge bg-success bg-opacity-10 text-success px-2 py-1 flex-shrink-0">Active</span>
            <% } else { %>
              <span class="badge bg-secondary bg-opacity-10 text-secondary px-2 py-1 flex-shrink-0">Inactive</span>
            <% } %>
          </div>

          <!-- Price & Financial Matrix Pills -->
          <div class="row g-2 text-center my-2">
            <div class="col-4">
              <div class="bg-white rounded p-1 border">
                <div class="text-muted extra-small" style="font-size: 0.7rem;">Selling Price</div>
                <div class="fw-bold text-primary small">₹<%= parseFloat(p.price || 0).toLocaleString('en-IN') %></div>
              </div>
            </div>
            <div class="col-4">
              <div class="bg-white rounded p-1 border">
                <div class="text-muted extra-small" style="font-size: 0.7rem;">Vendor Cost</div>
                <div class="text-secondary small">₹<%= parseFloat(p.vendor_cost || 0).toLocaleString('en-IN') %></div>
                <% if (p.vendor_name) { %>
                  <div class="text-muted text-truncate" style="font-size: 0.65rem;" title="<%= p.vendor_name %>"><%= p.vendor_name %></div>
                <% } %>
              </div>
            </div>
            <div class="col-4">
              <div class="bg-white rounded p-1 border">
                <div class="text-muted extra-small" style="font-size: 0.7rem;">Margin</div>
                <div class="fw-bold text-success small">₹<%= parseFloat(p.profit_margin || 0).toLocaleString('en-IN') %></div>
              </div>
            </div>
          </div>

          <!-- Share Link & Action Controls -->
          <div class="mt-3">
            <label class="form-label text-muted mb-1" style="font-size: 0.75rem;">Private Share Link</label>
            <div class="input-group input-group-sm mb-2">
              <input type="text" class="form-control text-truncate" value="<%= productUrl %>" readonly id="link-mobile-<%= p.id %>">
              <button class="btn btn-outline-secondary" onclick="copyLink('link-mobile-<%= p.id %>', this)" title="Copy Link">
                <i class="bi bi-clipboard"></i>
              </button>
              <a href="https://wa.me/?text=<%= waText %>" target="_blank" class="btn btn-outline-success" title="Share on WhatsApp">
                <i class="bi bi-whatsapp"></i>
              </a>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-2 pt-2 border-top">
              <a href="/admin/products/edit/<%= p.id %>" class="btn btn-sm btn-outline-dark px-3">
                <i class="bi bi-pencil-fill me-1"></i> Edit
              </a>
              <form action="/admin/products/delete/<%= p.id %>" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this product?');">
                <button type="submit" class="btn btn-sm btn-outline-danger px-3">
                  <i class="bi bi-trash-fill me-1"></i> Delete
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- Pagination Controls -->
    <% if (pagination.totalPages > 1) { %>
      <% 
        const queryString = `search=${encodeURIComponent(filters.search)}&category=${encodeURIComponent(filters.category)}&status=${encodeURIComponent(filters.status)}`;
      %>
      <nav class="d-flex justify-content-center mt-4">
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= pagination.currentPage === 1 ? 'disabled' : '' %>">
            <a class="page-link" href="/admin/products?<%= queryString %>&page=<%= pagination.currentPage - 1 %>">Previous</a>
          </li>
          
          <% for(let i = 1; i <= pagination.totalPages; i++) { %>
            <li class="page-item <%= pagination.currentPage === i ? 'active' : '' %>">
              <a class="page-link" href="/admin/products?<%= queryString %>&page=<%= i %>"><%= i %></a>
            </li>
          <% } %>

          <li class="page-item <%= pagination.currentPage === pagination.totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="/admin/products?<%= queryString %>&page=<%= pagination.currentPage + 1 %>">Next</a>
          </li>
        </ul>
      </nav>
    <% } %>

  <% } else { %>
    <div class="text-center py-5">
      <div class="fs-1 text-muted mb-3"><i class="bi bi-search"></i></div>
      <h5>No Matching Products Found</h5>
      <p class="text-muted small">Try adjusting your search query or reset filters.</p>
      <a href="/admin/products" class="btn btn-sm btn-outline-secondary">Reset Filters</a>
    </div>
  <% } %>
</div>

<script>
  function copyLink(inputId, btn) {
    const input = document.getElementById(inputId);
    input.select();
    navigator.clipboard.writeText(input.value);
    const originalIcon = btn.innerHTML;
    btn.innerHTML = '<i class="bi bi-check2 text-success"></i>';
    setTimeout(() => { btn.innerHTML = originalIcon; }, 2000);
  }
</script>

<%- include('../../layouts/admin_footer') %>
