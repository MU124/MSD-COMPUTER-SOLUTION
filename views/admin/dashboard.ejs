<%- include('../layouts/admin_header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-1">Dashboard</h2>
    <p class="text-muted small mb-0">Overview of your private product ecosystem and categories.</p>
  </div>
  <a href="/admin/products/add" class="btn btn-primary-custom">
    <i class="bi bi-plus-lg me-1"></i> Add New Product
  </a>
</div>

<!-- Metrics Cards -->
<div class="row g-4 mb-5">
  <div class="col-md-4">
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
      <div class="d-flex align-items-center gap-3">
        <div class="p-3 bg-info bg-opacity-10 text-info rounded-3 fs-3"><i class="bi bi-box-seam-fill"></i></div>
        <div>
          <div class="text-muted small">Total Private Products</div>
          <div class="display-6 fw-bold text-dark"><%= totalProducts %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
      <div class="d-flex align-items-center gap-3">
        <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3 fs-3"><i class="bi bi-tags-fill"></i></div>
        <div>
          <div class="text-muted small">Categories</div>
          <div class="display-6 fw-bold text-dark"><%= totalCategories %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
      <div class="d-flex align-items-center gap-3">
        <div class="p-3 bg-success bg-opacity-10 text-success rounded-3 fs-3"><i class="bi bi-shield-lock-fill"></i></div>
        <div>
          <div class="text-muted small">Public Product Listing</div>
          <div class="fs-5 fw-bold text-success">HIDDEN (Private Links)</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Recent Products Table -->
<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
  <h5 class="fw-bold mb-3">Recent Products Added</h5>
  <% if (recentProducts && recentProducts.length > 0) { %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Product Name</th>
            <th>Brand</th>
            <th>Selling Price</th>
            <th>Vendor Cost</th>
            <th>Profit Margin</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% recentProducts.forEach(p => { %>
            <tr>
              <td class="fw-semibold"><%= p.name %></td>
              <td><%= p.brand || '-' %></td>
              <td class="text-primary fw-bold">₹<%= parseFloat(p.price || 0).toLocaleString('en-IN') %></td>
              <td class="text-muted">₹<%= parseFloat(p.vendor_cost || 0).toLocaleString('en-IN') %></td>
              <td class="text-success fw-semibold">₹<%= parseFloat(p.profit_margin || 0).toLocaleString('en-IN') %></td>
              <td>
                <a href="/admin/products/edit/<%= p.id %>" class="btn btn-sm btn-outline-dark">
                  <i class="bi bi-pencil-fill"></i> Edit
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <p class="text-muted mb-0 small">No products added yet. Click "Add New Product" to create your first item.</p>
  <% } %>
</div>

<%- include('../layouts/admin_footer') %>
