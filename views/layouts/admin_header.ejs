<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">

<div class="container-fluid p-0">
  <div class="row g-0">

    <!-- Admin Sidebar -->
    <div class="col-lg-2 admin-sidebar d-flex flex-column p-3">
      <a href="/admin/dashboard" class="d-flex align-items-center gap-2 text-decoration-none px-3 py-2 mb-4">
        <span class="logo-badge">MSD</span>
        <span class="fw-bold text-white fs-5">Control Hub</span>
      </a>

      <nav class="d-flex flex-column gap-1 mb-auto">
        <a href="/admin/dashboard" class="admin-nav-item <%= page === 'dashboard' ? 'active' : '' %>">
          <i class="bi bi-speedometer2"></i> Dashboard
        </a>
        <a href="/admin/products" class="admin-nav-item <%= page === 'products' ? 'active' : '' %>">
          <i class="bi bi-box-seam-fill"></i> Private Catalog
        </a>
        <a href="/admin/categories" class="admin-nav-item <%= page === 'categories' ? 'active' : '' %>">
          <i class="bi bi-tags-fill"></i> Categories
        </a>
        <a href="/admin/settings" class="admin-nav-item <%= page === 'settings' ? 'active' : '' %>">
          <i class="bi bi-gear-fill"></i> Website Settings
        </a>
        <a href="/" target="_blank" class="admin-nav-item">
          <i class="bi bi-globe"></i> View Website
        </a>
      </nav>

      <div class="border-top border-secondary border-opacity-25 pt-3 px-3">
        <div class="small text-secondary mb-2">Logged in as:</div>
        <div class="fw-bold text-white mb-2"><%= admin ? admin.full_name : 'Admin' %></div>
        <a href="/admin/logout" class="btn btn-outline-danger btn-sm w-100">
          <i class="bi bi-box-arrow-right me-1"></i> Logout
        </a>
      </div>
    </div>

    <!-- Main Content Area -->
    <div class="col-lg-10 p-4 p-md-5">
