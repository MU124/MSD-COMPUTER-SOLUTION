<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- Cropper.js CSS & JS -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">

<!-- Mobile Top Header (< 992px) -->
<header class="navbar navbar-dark bg-dark d-lg-none sticky-top py-2 px-3 border-bottom border-secondary border-opacity-25">
  <div class="container-fluid p-0 d-flex justify-content-between align-items-center">
    <a href="/admin/dashboard" class="d-flex align-items-center gap-2 text-decoration-none">
      <img src="/images/logo.png" alt="MSD Logo" style="height: 42px; width: auto; object-fit: contain;">
      <span class="fw-bold text-white fs-6">Control Hub</span>
    </a>

    <button class="btn btn-outline-light btn-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminMobileSidebar" aria-controls="adminMobileSidebar">
      <i class="bi bi-list fs-5"></i>
    </button>
  </div>
</header>

<!-- Mobile Offcanvas Drawer -->
<div class="offcanvas offcanvas-start bg-dark text-white d-lg-none" tabindex="-1" id="adminMobileSidebar" aria-labelledby="adminMobileSidebarLabel">
  <div class="offcanvas-header border-bottom border-secondary border-opacity-25">
    <div class="d-flex align-items-center gap-2" id="adminMobileSidebarLabel">
      <img src="/images/logo.png" alt="MSD Logo" style="height: 48px; width: auto; object-fit: contain;">
      <span class="fw-bold text-white fs-5">Control Hub</span>
    </div>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>

  <div class="offcanvas-body d-flex flex-column p-3">
    <nav class="d-flex flex-column gap-1 mb-auto">
      <a href="/admin/dashboard" class="admin-nav-item <%= page === 'dashboard' ? 'active' : '' %>">
        <i class="bi bi-speedometer2"></i> Dashboard
      </a>
      <a href="/admin/products" class="admin-nav-item <%= page === 'products' ? 'active' : '' %>">
        <i class="bi bi-box-seam-fill"></i> Private Catalog
      </a>
      <a href="/admin/categories" class="admin-nav-item <%= page === 'categories' ? 'active' : '' %>">
        <i class="bi bi-tags-fill"></i> Categories
      </a>
      <a href="/admin/settings" class="admin-nav-item <%= page === 'settings' ? 'active' : '' %>">
        <i class="bi bi-gear-fill"></i> Website Settings
      </a>
      <a href="/" target="_blank" class="admin-nav-item">
        <i class="bi bi-globe"></i> View Website
      </a>
    </nav>

    <div class="border-top border-secondary border-opacity-25 pt-3 mt-3">
      <div class="small text-secondary mb-1">Logged in as:</div>
      <div class="fw-bold text-white mb-3"><%= admin ? admin.full_name : 'Admin' %></div>
      <a href="/admin/logout" class="btn btn-outline-danger btn-sm w-100">
        <i class="bi bi-box-arrow-right me-1"></i> Logout
      </a>
    </div>
  </div>
</div>

<div class="container-fluid p-0">
  <div class="row g-0">

    <!-- Desktop Sidebar (>= 992px) -->
    <div class="col-lg-2 admin-sidebar d-none d-lg-flex flex-column p-3">
      <a href="/admin/dashboard" class="d-flex align-items-center gap-2 text-decoration-none px-2 py-1 mb-4">
        <img src="/images/logo.png" alt="MSD Logo" style="height: 52px; width: auto; object-fit: contain;">
        <span class="fw-bold text-white fs-5">Control Hub</span>
      </a>

      <nav class="d-flex flex-column gap-1 mb-auto">
        <a href="/admin/dashboard" class="admin-nav-item <%= page === 'dashboard' ? 'active' : '' %>">
          <i class="bi bi-speedometer2"></i> Dashboard
        </a>
        <a href="/admin/products" class="admin-nav-item <%= page === 'products' ? 'active' : '' %>">
          <i class="bi bi-box-seam-fill"></i> Private Catalog
        </a>
        <a href="/admin/categories" class="admin-nav-item <%= page === 'categories' ? 'active' : '' %>">
          <i class="bi bi-tags-fill"></i> Categories
        </a>
        <a href="/admin/settings" class="admin-nav-item <%= page === 'settings' ? 'active' : '' %>">
          <i class="bi bi-gear-fill"></i> Website Settings
        </a>
        <a href="/" target="_blank" class="admin-nav-item">
          <i class="bi bi-globe"></i> View Website
        </a>
      </nav>

      <div class="border-top border-secondary border-opacity-25 pt-3 px-3">
        <div class="small text-secondary mb-2">Logged in as:</div>
        <div class="fw-bold text-white mb-2"><%= admin ? admin.full_name : 'Admin' %></div>
        <a href="/admin/logout" class="btn btn-outline-danger btn-sm w-100">
          <i class="bi bi-box-arrow-right me-1"></i> Logout
        </a>
      </div>
    </div>

    <!-- Main Content Area -->
    <div class="col-lg-10 p-3 p-md-4 p-lg-5">
