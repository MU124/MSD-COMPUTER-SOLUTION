<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="MSD Computer Solution - Professional Computer, Laptop Repair, CCTV, Data Recovery & Networking Services in Mumbai.">
  
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- Top Bar -->
  <div class="bg-dark text-light py-2 border-bottom border-secondary border-opacity-25 fs-7">
    <div class="container d-flex justify-content-between align-items-center flex-wrap">
      <div class="d-flex align-items-center gap-4">
        <span class="d-none d-md-inline"><i class="bi bi-clock text-info me-1"></i> <%= (settings && settings.working_hours) || 'Mon - Sat: 9:00 AM - 8:00 PM' %></span>
        <span><i class="bi bi-geo-alt text-info me-1"></i> Goregaon East, Mumbai</span>
      </div>
      <div class="d-flex align-items-center gap-3">
        <a href="tel:<%= (settings && settings.phone_primary) || '+919821760849' %>" class="text-light text-decoration-none fw-semibold">
          <i class="bi bi-telephone-fill text-info me-1"></i> <%= (settings && settings.phone_primary) || '+91 9821760849' %>
        </a>
      </div>
    </div>
  </div>

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top">
    <div class="container">
      <a class="navbar-brand py-0" href="/">
        <img src="/images/logo.png" alt="MSD Computer Solution" class="site-logo">
      </a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="mainNavbar">
        <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
          <li class="nav-item">
            <a class="nav-link nav-link-custom <%= page === 'home' ? 'active' : '' %>" href="/">Home</a>
          </li>
          <li class="nav-item">
            <a class="nav-link nav-link-custom <%= page === 'services' ? 'active' : '' %>" href="/services">Services</a>
          </li>
          <li class="nav-item">
            <a class="nav-link nav-link-custom <%= page === 'about' ? 'active' : '' %>" href="/about">About Us</a>
          </li>
          <li class="nav-item">
            <a class="nav-link nav-link-custom" href="/#why-us">Why Choose Us</a>
          </li>
          <li class="nav-item">
            <a class="nav-link nav-link-custom" href="/#faq">FAQ</a>
          </li>
          <li class="nav-item">
            <a class="nav-link nav-link-custom <%= page === 'contact' ? 'active' : '' %>" href="/contact">Contact Us</a>
          </li>
          <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
            <a class="btn btn-primary-custom" href="/contact">
              <i class="bi bi-chat-text-fill me-1"></i> Get Free Quote
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>
